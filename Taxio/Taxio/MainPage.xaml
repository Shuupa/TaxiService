<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Taxio.MainPage">
    <StackLayout BackgroundColor="DimGray">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <ImageButton x:Name="FlyoutMenu" Clicked="FlyoutMenu_Click" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Source="Profile.png" CornerRadius="50" Margin="10,10,0,0" HorizontalOptions="Start" BackgroundColor="DimGray"/>
            <StackLayout Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="7" Grid.RowSpan="8" >
                <Frame BackgroundColor="White" HeightRequest="400" CornerRadius="30">
                    <AbsoluteLayout>
                        <Grid AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Label Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" x:Name="Entry1" TextColor="DimGray" Text="Адрес подачи:" HorizontalOptions="Start"/>
                            <Frame Grid.Row="1" Grid.ColumnSpan="5" BackgroundColor="DimGray" HorizontalOptions="FillAndExpand" CornerRadius="15">
                            </Frame>
                            <SearchBar x:Name="PosRN_Search_AdressTo" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" FontSize="12" SearchButtonPressed="PosRN_Search_OnSearchButtonPressed" IsEnabled="True" Placeholder="Введите адрес..."/>
                            <Label Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="3" TextColor="DimGray" Text="Адрес прибытия:"/>
                            <Frame Grid.Row="3" Grid.ColumnSpan="5" BackgroundColor="DimGray" HorizontalOptions="FillAndExpand" CornerRadius="15">
                            </Frame>
                            <SearchBar x:Name="PosRN_Search_AdressToGo" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" FontSize="12" SearchButtonPressed="PosRN_Search_OnSearchButtonPressed2" IsEnabled="True" Placeholder="Введите адрес..."/>
                            <Label x:Name="TimeToTravel" Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="5" TextColor="DimGray" Text="В пути: 40 Минут / 25 КМ" FontSize="16" HorizontalTextAlignment="Center" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"/>
                            <Label x:Name="DriverNamenCar" Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="5" TextColor="DimGray" Text="" FontSize="16" HorizontalTextAlignment="Center" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"/>
                            <Label x:Name="OrderPrice" Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="5" TextColor="DimGray"  Text="Стоимость поездки: 753" FontSize="16" HorizontalTextAlignment="Center" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"/>
                            <Frame Grid.Column="1" Grid.Row="7" Grid.ColumnSpan="3" BorderColor="DimGray" CornerRadius="10">
                            </Frame>
                            <Label x:Name="Car_GosNum" Grid.Column="1" Grid.Row="7" Grid.ColumnSpan="3" TextColor="DimGray"  TextTransform="Uppercase" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" FontAttributes="Bold" FontSize="24"/>
                            <StackLayout IsVisible="False" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="5" Grid.RowSpan="8" x:Name="menuLayout" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="-10,-10,-10,-10">
                                <Frame x:Name="Menuframe" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" CornerRadius="20" Scale="1.07">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <ImageButton Grid.Column="0" Grid.Row="0" Source="Profile.png" BackgroundColor="DimGray" IsEnabled="False" CornerRadius="50" WidthRequest="50" HeightRequest="50" VerticalOptions="Start" HorizontalOptions="Start"/>
                                        <Label x:Name="USER_ID" Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="0" HorizontalOptions="Center" VerticalOptions="Start" FontSize="12" Text="ID:8391248125792"/>
                                        <Label x:Name="USERNAME" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="3" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Text="Афонасьев Виктор Павлович"/>
                                    </Grid>
                                </Frame>
                            </StackLayout>
                        </Grid>
                    </AbsoluteLayout>
                </Frame>
            </StackLayout>
            <StackLayout Grid.Column="0" Grid.Row="9" Grid.ColumnSpan="9" Grid.RowSpan="6" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                <Frame CornerRadius="20" HeightRequest="100" Margin="0,10,0,0" BackgroundColor="LightGray" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <AbsoluteLayout>
                        <Grid AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <ImageButton Source="Eco_Car_Ref.png" Padding="20" Grid.Column="0" Grid.Row="0" Grid.RowSpan="4" Grid.ColumnSpan="2" x:Name="EconomButton" Clicked="EconomButton_Click" BackgroundColor="DarkGreen" Margin="0,-10,0,20" CornerRadius="20" WidthRequest="90" HeightRequest="85" AbsoluteLayout.LayoutBounds="0.5,0.5,0.1,0.1" AbsoluteLayout.LayoutFlags="PositionProportional" Aspect="AspectFit"/>
                            <ImageButton Source="Bui_Car_Ref.png" Padding="20" Grid.Column="4" Grid.Row="0" Grid.RowSpan="4" Grid.ColumnSpan="2" x:Name="BusinessButton" Clicked="BusinessButton_Click" BackgroundColor="#2D2DDF" Margin="0,-10,0,20" CornerRadius="20" WidthRequest="90" HeightRequest="85" AbsoluteLayout.LayoutBounds="0.5,0.5,0.1,0.1" AbsoluteLayout.LayoutFlags="PositionProportional" Aspect="AspectFit"/>
                            <ImageButton Source="Comf_Car_Ref.png" Padding="20" Grid.Column="2" Grid.Row="0" Grid.RowSpan="4" Grid.ColumnSpan="2"  x:Name="ComfortButton" Clicked="ComfortButton_Click" BackgroundColor="#BE8F56" Margin="0,-10,0,20" CornerRadius="20" WidthRequest="90" HeightRequest="85" AbsoluteLayout.LayoutBounds="0.5,0.5,0.1,0.1" AbsoluteLayout.LayoutFlags="PositionProportional" Aspect="AspectFit"/>
                            <Label Grid.Column="0" Grid.ColumnSpan="2" Text="Эконом" TextColor="White" FontSize="15" HorizontalTextAlignment="Center" Margin="-5,-3,0,0" InputTransparent="True"/>
                            <Label Grid.Column="2" Grid.ColumnSpan="2" Text="Комфорт" TextColor="White" FontSize="15" HorizontalTextAlignment="Center" Margin="-5,-3,0,0" InputTransparent="True"/>
                            <Label Grid.Column="4" Grid.ColumnSpan="2" Text="Business" TextColor="White" FontSize="15" HorizontalTextAlignment="Center" Margin="-5,-3,0,0" InputTransparent="True"/>
                            <Label Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" x:Name="Eco_PickerDelay" Text="" TextColor="White" FontSize="12" HorizontalTextAlignment="Center" Margin="-5,0,0,0" InputTransparent="True"/>
                            <Label Grid.Column="2" Grid.Row="2" Grid.ColumnSpan="2" x:Name="Comf_PickerDelay" Text="" TextColor="White" FontSize="12" HorizontalTextAlignment="Center" Margin="-5,0,0,0" InputTransparent="True"/>
                            <Label Grid.Column="4" Grid.Row="2" Grid.ColumnSpan="2" x:Name="Bui_PickerDelay" Text="" TextColor="White" FontSize="12" HorizontalTextAlignment="Center" Margin="-5,0,0,0" InputTransparent="True"/>
                        </Grid>
                    </AbsoluteLayout>
                </Frame>
                <Frame CornerRadius="20" HeightRequest="100" Margin="0,-40,0,0" BackgroundColor="White">
                    <AbsoluteLayout>
                        <Grid AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <Label TextColor="DimGray" FontFamily="Consola" FontSize="22" Grid.Column="1" Grid.ColumnSpan="1" Text="Водитель прибудет через 3 минуты" VerticalOptions="Start" HorizontalOptions="CenterAndExpand" HorizontalTextAlignment="Center"/>
                        </Grid>
                    </AbsoluteLayout>
                </Frame>
                <Frame CornerRadius="20" HeightRequest="80" Margin="0,-50,0,-20" BackgroundColor="DimGray">
                    <AbsoluteLayout>
                        <Grid AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="OrderGoButton" FontSize="25" WidthRequest="362" HeightRequest="75" Margin="0,-5,0,0" CornerRadius="20" BackgroundColor="DarkGray" TextColor="White" Grid.Column="0" Grid.ColumnSpan="3" Text="Заказать" VerticalOptions="Start" HorizontalOptions="CenterAndExpand"/>
                        </Grid>
                    </AbsoluteLayout>
                </Frame>
            </StackLayout>
        </Grid>
    </StackLayout>
</ContentPage>
