<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Taxio.MainPage">
    <StackLayout BackgroundColor="DarkGray">
        <Button HorizontalOptions="Start" HeightRequest="50" WidthRequest="50" CornerRadius="50" Margin="10,10,0,0" BackgroundColor="White"/>
        <StackLayout>
            <Frame BackgroundColor="White" Margin="40,20,40,0" HeightRequest="400" CornerRadius="30">
                <AbsoluteLayout>
                    <Label x:Name="Entry1" Text="Адрес подачи:" HorizontalOptions="Start"/>
                    
                </AbsoluteLayout>
            </Frame>
        </StackLayout>
        <StackLayout>
            <Frame CornerRadius="20" HeightRequest="100" Margin="0,10,0,0" BackgroundColor="LightGray">
                <AbsoluteLayout>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Button Grid.Column="0" Grid.Row="0" x:Name="EconomButton" BackgroundColor="DarkGreen" Margin="0,-10,0,10" CornerRadius="20" WidthRequest="90" HeightRequest="85"/>
                        <Button Grid.Column="2" Grid.Row="0" x:Name="BusinessButton" BackgroundColor="DarkBlue" Margin="0,-10,0,10" CornerRadius="20" WidthRequest="90" HeightRequest="85"/>
                        <Button Grid.Column="1" Grid.Row="0" x:Name="ComfortButton" BackgroundColor="#BE8F56" Margin="0,-10,0,10" CornerRadius="20" WidthRequest="90" HeightRequest="85"/>
                    </Grid>
                    <Image Source="Bui_Car_Ref.png" Margin="285,20,0,0" Scale="0.8"/>
                    <Image Source="Comf_Car_Ref.png" Margin="96,2,0,0" Scale="0.35"/>
                    <Image Source="Eco_Car_Ref.png" Margin="-45,2,0,0" Scale="0.35"/>
                    <Label Text="Эконом" TextColor="White" Margin="10,0,0,0" FontSize="12"/>
                    <Label Text="Комфорт" TextColor="White" Margin="150,0,0,0" FontSize="12"/>
                    <Label Text="Business" TextColor="White" Margin="295,0,0,0" FontSize="12"/>
                    <Label x:Name="Eco_Picker" TextColor="White" Margin="10,45,0,0" FontSize="12"/>
                    <Label Text="Комфорт" TextColor="White" Margin="150,45,0,0" FontSize="12"/>
                    <Label Text="Business" TextColor="White" Margin="295,45,0,0" FontSize="12"/>
                    
                </AbsoluteLayout>
            </Frame>
            <Frame CornerRadius="20" HeightRequest="100" Margin="0,-40,0,0" BackgroundColor="White">
                
            </Frame>
            <Frame CornerRadius="20" HeightRequest="100" Margin="0,-50,0,-20" BackgroundColor="DarkGray">
                
            </Frame>
        </StackLayout>
    </StackLayout>
</ContentPage>
